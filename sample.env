# YouTube API Base URL (Railway music API)
YT_API_BASE_URL=https://youtube-api-music-production-824b.up.railway.app
YT_API_KEY=SLtWox3TFKKHuMySdvz_4y2Ju3NlSHYk

# Priority order for obtaining a stream / download (comma or space separated).
# Keys: yt_api, xbit, aruyt, nexgen, local
# "local" = yt-dlp on this server (needs COOKIES_DATA + Node >= 23.5 for YouTube n-signature).
# The first source that returns a result wins. Live play uses this order; queued
# songs are downloaded in the background using the same order.
# DEFAULT LEADS WITH local (Railway/server IP is currently bot-blocked by YouTube).
# To prefer hosted APIs instead, use e.g. PLAY_PRIORITY=yt_api,local,xbit
PLAY_PRIORITY=local,yt_api,xbit,aruyt,nexgen

# limits for the bot
QUEUE_LIMIT=50
DURATION_LIMIT=5400
PLAYLIST_LIMIT=20

# REQUIRED to bypass YouTube's "Sign in to confirm you're a bot" check on the
# local yt-dlp downloader. Base64-encoded Netscape-format cookies.txt exported
# from a browser logged into YouTube. Generate with:
#   base64 -i cookies.txt | tr -d '\n'   (then paste the single line below)
# The server decodes this into Lily/cookies/cookie_0.txt at startup.
COOKIES_DATA=
